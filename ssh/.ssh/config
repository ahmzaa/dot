# Managed by dotfiles (stow package: ssh)
#
# Machine-specific / sensitive host blocks live in ~/.ssh/config.local
# (not tracked by this repo). See docs/ssh-cert-setup.md.
Include ~/.ssh/config.local

Host *
    # Linux OpenSSH does not know the macOS-only `UseKeychain` keyword and would
    # reject the whole config at parse time (a `Match exec` guard does not help
    # because the keyword is rejected before any Match is evaluated).
    # IgnoreUnknown makes non-macOS OpenSSH silently skip it instead.
    IgnoreUnknown UseKeychain
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519

# macOS only: load/store key passphrases in the Keychain.
Match exec "uname -s | grep -q Darwin"
    UseKeychain yes
