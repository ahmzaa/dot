# Managed by dotfiles (stow package: ssh)
#
# Machine-specific / sensitive host blocks live in ~/.ssh/config.local
# (not tracked by this repo). See docs/ssh-cert-setup.md.
Include ~/.ssh/config.local

Host 10.10.100.9
    Port 22

Host 10.10.100.10
    Port 22

Host 10.10.10.13
    Port 22

Host 10.10.10.* 10.10.20.* 10.10.99.* 10.10.100.*
    Port 2222
    User ahmza
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519
    CertificateFile ~/.ssh/id_ed25519-cert.pub

Host 100.71.*
    Port 2222
    User ansible
    IdentitiesOnly yes
    AddKeysToAgent no
    IdentityFile ~/.ssh/ansible

Host 127.0.0.1 localhost
    AddKeysToAgent no

# IdentityFile is cumulative, so a bare `Host *` entry would append
# id_ed25519 to the ansible hosts' identity list and offer it there even
# under IdentitiesOnly. Scope it so those hosts only ever offer ~/.ssh/ansible.
Host * !100.71.*
    IdentityFile ~/.ssh/id_ed25519

Host *
    # Linux OpenSSH does not know the macOS-only `UseKeychain` keyword and would
    # reject the whole config at parse time (a `Match exec` guard does not help
    # because the keyword is rejected before any Match is evaluated).
    # IgnoreUnknown makes non-macOS OpenSSH silently skip it instead.
    IgnoreUnknown UseKeychain
    AddKeysToAgent yes

# macOS only: load/store key passphrases in the Keychain.
Match exec "uname -s | grep -q Darwin"
    UseKeychain yes
