# Machine-specific SSH config — copy to ~/.ssh/config.local and edit.
# This file is NOT tracked by the dotfiles repo (see .gitignore).
#
# CA host used by `ssh-cert` for certificate renewal. Transport auth is
# key-based (the bootstrap key), while the remote CA signing key prompts for
# its own passphrase when renewal is due. ControlMaster is optional because
# renewal now uses one signing connection plus a short preflight connection.

# Host ca
#     HostName <ca-host-or-ip>
#     User <your-login>
#     IdentityFile ~/.ssh/id_ed25519
#     ControlMaster auto
#     ControlPath ~/.ssh/cm-%r@%h:%p
#     ControlPersist 10m
