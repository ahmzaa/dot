#!/usr/bin/env bash

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wallpp_cache"
mkdir -p -- "$CACHE_DIR" || exit 1

IMG_PATH=${1:-}
TARGET_MONITOR=${2:-}

if ! command -v jq >/dev/null 2>&1; then
  echo "Warning: swp requires jq to detect monitors. Please install jq and try again." >&2
  exit 1
fi

get_all_monitors() {
  hyprctl monitors -j | jq -r '.[].name'
}

apply_wall() {
  local wallpaper=$1
  local monitor=$2

  awww img "$wallpaper" \
    --outputs "$monitor" \
    --resize fit \
    --transition-type wave
}

mapfile -t ACTIVE_MONITORS < <(get_all_monitors)
if ((${#ACTIVE_MONITORS[@]} == 0)); then
  echo "Error: No active Hyprland monitors found." >&2
  exit 1
fi

# Restore mode: restore each active monitor's cached wallpaper.
if [[ -z $IMG_PATH ]]; then
  echo "Restoring wallpapers from cache"
  status=0

  for mon in "${ACTIVE_MONITORS[@]}"; do
    cache_file="$CACHE_DIR/$mon"
    [[ -f $cache_file ]] || continue

    IFS= read -r WALLPP < "$cache_file"
    if [[ ! -f $WALLPP ]]; then
      echo "Warning: Cached wallpaper for $mon no longer exists: $WALLPP" >&2
      status=1
      continue
    fi

    echo "Setting wallpaper for $mon"
    apply_wall "$WALLPP" "$mon" || status=1
  done

  exit "$status"
fi

# New image mode.
if ! WALLPP=$(realpath -e -- "$IMG_PATH") || [[ ! -f $WALLPP ]]; then
  echo "Error: File '$IMG_PATH' does not exist." >&2
  exit 1
fi

# Monitor selection.
if [[ $TARGET_MONITOR == "--select" ]]; then
  TARGET_MONITOR=$(printf '%s\n' "${ACTIVE_MONITORS[@]}" | fzf --prompt="Select Monitor: " --reverse --border)
  [[ -n $TARGET_MONITOR ]] || { echo "Selection cancelled."; exit 0; }
  SELECTED_MONITORS=("$TARGET_MONITOR")
elif [[ -n $TARGET_MONITOR ]]; then
  monitor_found=false
  for mon in "${ACTIVE_MONITORS[@]}"; do
    if [[ $mon == "$TARGET_MONITOR" ]]; then
      monitor_found=true
      break
    fi
  done

  if [[ $monitor_found != true ]]; then
    echo "Error: Monitor '$TARGET_MONITOR' not found." >&2
    exit 1
  fi
  SELECTED_MONITORS=("$TARGET_MONITOR")
else
  SELECTED_MONITORS=("${ACTIVE_MONITORS[@]}")
fi

# Apply to all selected monitors, caching only successful changes.
status=0
for mon in "${SELECTED_MONITORS[@]}"; do
  echo "Setting wallpaper for $mon"
  if apply_wall "$WALLPP" "$mon"; then
    printf '%s\n' "$WALLPP" > "$CACHE_DIR/$mon"
  else
    echo "Error: Failed to set wallpaper for $mon." >&2
    status=1
  fi
done

((status == 0)) || exit "$status"

# Generate Pywal16 colors.
if ! wal -i "$WALLPP" -n; then
  echo "Warning: Wallpaper changed, but wal failed to generate colors." >&2
  exit 1
fi

echo "Wallpaper updated for: ${SELECTED_MONITORS[*]}"
