#!/usr/bin/env bash
#####################################################################
# Dotfiles installer
#
# Cross-platform (macOS + Linux). Detects the package manager, lets you
# choose which stow packages to install (individually or by group),
# installs a curated set of core dependencies plus any per-package
# extras, checks neovim against the latest stable, stows your selection,
# and (optionally) sets zsh as your login shell.
#
# Safe to re-run; stow is applied with --restow.
#####################################################################
set -euo pipefail

#--------------------------------------------------------------------
# Output helpers
#--------------------------------------------------------------------
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; BLUE='\033[0;34m'; NC='\033[0m'
info()  { printf "${GREEN}==>${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}==> warning:${NC} %s\n" "$*"; }
error() { printf "${RED}==> error:${NC} %s\n" "$*" >&2; }
step()  { printf "\n${BLUE}==> %s${NC}\n" "$*"; }

confirm() {
    # confirm "Question?" -> returns 0 for yes, 1 for no (default No)
    local prompt="${1:-Continue?}" reply
    printf "${GREEN}%s${NC} [y/N] " "$prompt"
    read -r reply
    [[ "$reply" =~ ^[Yy]$ ]]
}

# Track dependencies we couldn't install so we can report them at the end.
MANUAL_DEPS=()

#--------------------------------------------------------------------
# Repo root (auto-detected from this script's location)
#--------------------------------------------------------------------
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# Every top-level dir except non-stow ones is a package.
# `work` is a real stow package but is CoreWeave/work-laptop specific, so it is
# excluded from auto-discovery (and therefore from `all`). It is offered
# explicitly via the `work` group so only the work machine opts into it.
NON_PACKAGES=(docs work)

# Print the repo banner (ASCII art) if present.
print_banner() {
    local banner="$REPO_DIR/zsh/.config/zsh/banner"
    if [[ -f "$banner" ]]; then
        printf "${GREEN}"
        cat "$banner"
        printf "${NC}\n"
    fi
}

#--------------------------------------------------------------------
# OS / package-manager detection
#--------------------------------------------------------------------
OS=""; PM=""
detect_platform() {
    case "$(uname -s)" in
        Darwin) OS="macos" ;;
        Linux)  OS="linux" ;;
        *) error "Unsupported OS: $(uname -s)"; exit 1 ;;
    esac

    if [[ "$OS" == "macos" ]]; then
        PM="brew"
    elif command -v apt >/dev/null 2>&1; then
        PM="apt"
    elif command -v pacman >/dev/null 2>&1; then
        PM="pacman"
    elif command -v dnf >/dev/null 2>&1; then
        PM="dnf"
    else
        error "No supported package manager found (need brew, apt, pacman or dnf)."
        exit 1
    fi
    info "Detected OS: $OS, package manager: $PM"
}

ensure_homebrew() {
    [[ "$PM" == "brew" ]] || return 0
    if ! command -v brew >/dev/null 2>&1; then
        info "Homebrew not found — installing..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        # Make brew available for the rest of this run.
        [[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
        [[ -x /usr/local/bin/brew ]] && eval "$(/usr/local/bin/brew shellenv)"
    fi
    return 0
}

#--------------------------------------------------------------------
# Package-name mapping: generic name -> per-manager name.
# Empty string means "not available on this manager" (skip).
#--------------------------------------------------------------------
map_pkg() {
    local name="$1"
    case "$name" in
        fd)
            case "$PM" in apt) echo "fd-find" ;; *) echo "fd" ;; esac ;;
        ripgrep) echo "ripgrep" ;;
        neovim)  echo "neovim" ;;
        pywal)
            case "$PM" in
                brew) echo "" ;;         # install via pip fallback
                pacman) echo "python-pywal" ;;
                *) echo "" ;;            # pip fallback
            esac ;;
        aerospace)
            case "$PM" in brew) echo "nikitabobko/tap/aerospace" ;; *) echo "" ;; esac ;;
        *) echo "$name" ;;               # default: same name everywhere
    esac
}

pm_install_raw() {
    # Install already-mapped package names for the current manager.
    local pkgs=("$@")
    [[ ${#pkgs[@]} -eq 0 ]] && return 0
    case "$PM" in
        brew)   brew install "${pkgs[@]}" ;;
        apt)    sudo apt install -y "${pkgs[@]}" ;;
        pacman) sudo pacman -S --needed --noconfirm "${pkgs[@]}" ;;
        dnf)    sudo dnf install -y "${pkgs[@]}" ;;
    esac
}

pkg_install() {
    # Install a list of GENERIC names; maps each and installs one-by-one so a
    # single missing package doesn't abort the batch.
    local generic mapped
    for generic in "$@"; do
        mapped="$(map_pkg "$generic")"
        if [[ -z "$mapped" ]]; then
            # No package for this manager — handle special fallbacks.
            case "$generic" in
                pywal)
                    if command -v pip3 >/dev/null 2>&1; then
                        pip3 install --user pywal >/dev/null 2>&1 && continue
                    fi ;;
            esac
            warn "No '$generic' package for $PM — skipping."
            MANUAL_DEPS+=("$generic")
            continue
        fi
        if ! pm_install_raw "$mapped"; then
            warn "Failed to install '$generic' ($mapped) — continuing."
            MANUAL_DEPS+=("$generic")
        fi
    done
}

#--------------------------------------------------------------------
# Curated core dependencies (installed for every setup)
#--------------------------------------------------------------------
CORE_DEPS=(git stow zsh fzf ripgrep fd lsd lolcat tmux zoxide)
# neovim handled separately (version check).
# starship and yazi are their own stow packages, so they are installed as
# per-package dependencies (see pkg_deps / install_selected_deps) rather than
# unconditionally here.

# Remove an entry from MANUAL_DEPS (used when a fallback install succeeds).
# Avoid injecting an empty element when the result is empty (bash 3.2 would
# otherwise leave a single "" entry and make the array look non-empty).
unmark_manual() {
    local keep=() d
    for d in "${MANUAL_DEPS[@]:-}"; do
        [[ -z "$d" ]] && continue
        [[ "$d" == "$1" ]] || keep+=("$d")
    done
    MANUAL_DEPS=()
    if [[ ${#keep[@]} -gt 0 ]]; then
        MANUAL_DEPS=("${keep[@]}")
    fi
    return 0
}

# Ensure a C toolchain (cc/linker + make) exists — cargo source builds need it.
ensure_build_tools() {
    if { command -v cc >/dev/null 2>&1 || command -v gcc >/dev/null 2>&1; } \
        && command -v make >/dev/null 2>&1; then
        return 0
    fi
    info "Installing a C compiler toolchain (needed to build from source)..."
    case "$PM" in
        apt)    pkg_install build-essential ;;
        pacman) pkg_install base-devel ;;
        dnf)    sudo dnf groupinstall -y "Development Tools" 2>/dev/null || pkg_install gcc make ;;
        brew)   xcode-select --install 2>/dev/null || true ;;  # usually already present
    esac
    { command -v cc >/dev/null 2>&1 || command -v gcc >/dev/null 2>&1; } \
        && command -v make >/dev/null 2>&1
}

# Ensure cargo is available (for source-built fallbacks like yazi on apt).
ensure_cargo() {
    command -v cargo >/dev/null 2>&1 && return 0
    [[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"
    command -v cargo >/dev/null 2>&1 && return 0
    info "Installing Rust toolchain (rustup) for cargo-based installs..."
    curl -sSf https://sh.rustup.rs | sh -s -- -y >/dev/null 2>&1 || return 1
    [[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"
    command -v cargo >/dev/null 2>&1
}

# GOOS/GOARCH-style arch token for the official Go tarball.
go_tarball_arch() {
    case "$(uname -m)" in
        x86_64|amd64)  echo "amd64" ;;
        arm64|aarch64) echo "arm64" ;;
        *) return 1 ;;
    esac
}

# Ensure a Go toolchain is available (for `go install`-ed MCP servers). Tries
# PATH, then the package manager, then the official prebuilt tarball into
# /usr/local/go. Adds go + GOPATH bin to PATH for the rest of this run.
ensure_go() {
    command -v go >/dev/null 2>&1 && return 0
    [[ -x /usr/local/go/bin/go ]] && { export PATH="/usr/local/go/bin:$PATH"; return 0; }

    info "Installing Go toolchain..."
    case "$PM" in
        brew)   brew install go ;;
        apt)    sudo apt install -y golang-go ;;
        pacman) sudo pacman -S --needed --noconfirm go ;;
        dnf)    sudo dnf install -y golang ;;
    esac
    command -v go >/dev/null 2>&1 && return 0

    # Package manager didn't provide it — fall back to the official tarball.
    local arch os url tmp
    arch="$(go_tarball_arch)" || return 1
    case "$(uname -s)" in
        Darwin) os="darwin" ;;
        Linux)  os="linux" ;;
        *) return 1 ;;
    esac
    info "Fetching latest Go from go.dev ($os-$arch)..."
    local ver
    ver="$(curl -fsSL https://go.dev/VERSION?m=text 2>/dev/null | head -1)" || return 1
    [[ -n "$ver" ]] || return 1
    url="https://go.dev/dl/${ver}.${os}-${arch}.tar.gz"
    tmp="$(mktemp -d)"
    if curl -fsSL "$url" -o "$tmp/go.tar.gz"; then
        sudo rm -rf /usr/local/go
        sudo tar -C /usr/local -xzf "$tmp/go.tar.gz"
        rm -rf "$tmp"
        export PATH="/usr/local/go/bin:$PATH"
    else
        rm -rf "$tmp"; return 1
    fi
    command -v go >/dev/null 2>&1
}

install_core_deps() {
    step "Installing core dependencies"
    pkg_install "${CORE_DEPS[@]}"
}

# Fallbacks for tools not always packaged; called after their package's deps
# are attempted, only when that package was selected.
install_starship() {
    pkg_install starship
    if ! command -v starship >/dev/null 2>&1; then
        info "Installing starship via official script..."
        if curl -sS https://starship.rs/install.sh | sh -s -- -y; then
            unmark_manual starship
        fi
    fi
}

# ── opencode MCP servers ─────────────────────────────────────────────────────
# opencode/.config/opencode/opencode.jsonc wires up two local MCP servers, both
# Go binaries that ship official GoReleaser prebuilt releases:
#   engram    -> github.com/Gentleman-Programming/engram  (GitHub releases)
#   gitea-mcp -> gitea.com/gitea/gitea-mcp                (Gitea releases)
# We prefer the prebuilt binary (no Go toolchain needed), and fall back to
# `go install` only if the download fails. Binaries land in ~/.local/bin
# (already on PATH). Keep in sync with the "mcp" block in opencode.jsonc.

# Extract a single named binary from a downloaded tar.gz into ~/.local/bin.
# $1 = URL, $2 = binary name inside the archive.
install_binary_from_targz() {
    local url="$1" binname="$2" tmp
    tmp="$(mktemp -d)"
    if curl -fsSL "$url" -o "$tmp/dl.tar.gz" && tar xzf "$tmp/dl.tar.gz" -C "$tmp"; then
        mkdir -p "$HOME/.local/bin"
        find "$tmp" -type f -name "$binname" -exec install -m755 {} "$HOME/.local/bin/" \;
        rm -rf "$tmp"
        [[ -x "$HOME/.local/bin/$binname" ]]
    else
        rm -rf "$tmp"; return 1
    fi
}

# engram prebuilt: asset is engram_<version>_<goos>_<goarch>.tar.gz (version in
# the name, so we resolve the latest tag first). goos/goarch are lowercase.
install_engram() {
    command -v engram >/dev/null 2>&1 && { info "engram already installed."; unmark_manual engram; return 0; }

    local arch os ver url
    case "$(uname -m)" in
        x86_64|amd64)  arch="amd64" ;;
        arm64|aarch64) arch="arm64" ;;
        *) arch="" ;;
    esac
    case "$(uname -s)" in
        Darwin) os="darwin" ;;
        Linux)  os="linux" ;;
        *) os="" ;;
    esac
    if [[ -n "$arch" && -n "$os" ]]; then
        ver="$(curl -fsSL https://api.github.com/repos/Gentleman-Programming/engram/releases/latest 2>/dev/null \
               | sed -nE 's/.*"tag_name": *"v?([^"]+)".*/\1/p' | head -1)"
        if [[ -n "$ver" ]]; then
            url="https://github.com/Gentleman-Programming/engram/releases/latest/download/engram_${ver}_${os}_${arch}.tar.gz"
            info "Downloading engram v$ver prebuilt binary ($os/$arch)..."
            if install_binary_from_targz "$url" engram; then
                unmark_manual engram; return 0
            fi
        fi
    fi

    info "Prebuilt engram unavailable — trying 'go install'..."
    if ensure_go && go install github.com/Gentleman-Programming/engram/cmd/engram@latest; then
        unmark_manual engram; return 0
    fi
    warn "Could not install engram automatically."
    MANUAL_DEPS+=("engram (see github.com/Gentleman-Programming/engram)")
    return 1
}

# gitea-mcp prebuilt: asset is gitea-mcp_<OS>_<arch>.tar.gz (GoReleaser naming,
# same scheme as sesh — reuse goreleaser_os_arch()). Gitea has no
# /releases/latest/download/ shortcut, so resolve the tag via the API and build
# the explicit /releases/download/<tag>/ URL.
install_gitea_mcp() {
    command -v gitea-mcp >/dev/null 2>&1 && { info "gitea-mcp already installed."; unmark_manual gitea-mcp; return 0; }

    local osarch tag url
    if osarch="$(goreleaser_os_arch)"; then
        tag="$(curl -fsSL 'https://gitea.com/api/v1/repos/gitea/gitea-mcp/releases?limit=1' 2>/dev/null \
               | sed -nE 's/.*"tag_name":"([^"]+)".*/\1/p' | head -1)"
        if [[ -n "$tag" ]]; then
            url="https://gitea.com/gitea/gitea-mcp/releases/download/${tag}/gitea-mcp_${osarch}.tar.gz"
            info "Downloading gitea-mcp $tag prebuilt binary ($osarch)..."
            if install_binary_from_targz "$url" gitea-mcp; then
                unmark_manual gitea-mcp; return 0
            fi
        fi
    fi

    info "Prebuilt gitea-mcp unavailable — trying 'go install'..."
    if ensure_go && go install gitea.com/gitea/gitea-mcp@latest; then
        unmark_manual gitea-mcp; return 0
    fi
    warn "Could not install gitea-mcp automatically."
    MANUAL_DEPS+=("gitea-mcp (see gitea.com/gitea/gitea-mcp)")
    return 1
}

install_opencode_mcps() {
    step "Installing opencode MCP servers"
    install_engram
    install_gitea_mcp
}

# Let engram wire up its own opencode plugin/tui files (idempotent — it
# regenerates plugins/engram.ts + tui.json, and does NOT create a duplicate
# opencode.json when opencode.jsonc already defines the engram MCP block).
#
# MUST run after stow_packages. plugins/engram.ts is generated per-host and
# gitignored (its ENGRAM_BIN fallback is host-specific), so this repo does not
# ship it. Running this first would create a real ~/.config/opencode/plugins/
# directory and stop stow from folding the package into a single symlink; running
# it after means engram writes through that symlink instead.
setup_engram_opencode() {
    command -v engram >/dev/null 2>&1 || return 0
    step "Wiring up the engram opencode plugin"
    info "Running 'engram setup opencode'..."
    engram setup opencode || warn "engram setup opencode failed — the engram plugin will be missing; re-run 'engram setup opencode' manually."
}

install_opencode() {
    if ! command -v opencode >/dev/null 2>&1; then
        info "Installing opencode via official script..."
        if curl -fsSL https://opencode.ai/install | bash; then
            unmark_manual opencode
        else
            warn "Could not install opencode automatically."
            MANUAL_DEPS+=("opencode")
        fi
    else
        info "opencode already installed."
    fi

    # opencode is configured with local MCP servers — install them too.
    install_opencode_mcps
}

# Rust target triple for prebuilt-binary downloads (yazi et al.).
target_triple() {
    local arch os
    case "$(uname -m)" in
        x86_64|amd64) arch="x86_64" ;;
        arm64|aarch64) arch="aarch64" ;;
        *) return 1 ;;
    esac
    case "$(uname -s)" in
        Darwin) os="apple-darwin" ;;
        Linux)  os="unknown-linux-gnu" ;;
        *) return 1 ;;
    esac
    echo "${arch}-${os}"
}

# Install yazi from the official GitHub prebuilt binary (fast, no toolchain).
# Assets look like: yazi-<triple>.zip containing `yazi` and `ya`.
install_yazi_from_github() {
    local triple url tmp
    triple="$(target_triple)" || return 1
    command -v unzip >/dev/null 2>&1 || pkg_install unzip
    command -v unzip >/dev/null 2>&1 || return 1
    url="https://github.com/sxyazi/yazi/releases/latest/download/yazi-${triple}.zip"
    tmp="$(mktemp -d)"
    info "Downloading yazi prebuilt binary ($triple)..."
    if curl -fsSL "$url" -o "$tmp/yazi.zip" && unzip -q "$tmp/yazi.zip" -d "$tmp"; then
        mkdir -p "$HOME/.local/bin"
        # Binaries live in a subdir named after the asset.
        find "$tmp" -type f \( -name yazi -o -name ya \) -exec install -m755 {} "$HOME/.local/bin/" \;
        rm -rf "$tmp"
        command -v yazi >/dev/null 2>&1 || [[ -x "$HOME/.local/bin/yazi" ]]
    else
        rm -rf "$tmp"
        return 1
    fi
}

install_yazi() {
    pkg_install yazi
    command -v yazi >/dev/null 2>&1 && return 0

    # Not packaged (e.g. apt). Try fastest options first:
    #   1) official prebuilt GitHub binary (no build)
    #   2) cargo binstall (prebuilt via cargo)
    #   3) build from source via the 'yazi-build' meta-crate (Cargo limitation)
    info "yazi not available via $PM — trying prebuilt binary..."
    if install_yazi_from_github; then
        unmark_manual yazi; return 0
    fi

    if command -v cargo-binstall >/dev/null 2>&1 || \
       { ensure_cargo && cargo install cargo-binstall >/dev/null 2>&1; }; then
        info "Installing yazi via cargo binstall..."
        if cargo binstall -y yazi-fm yazi-cli; then
            unmark_manual yazi; return 0
        fi
    fi

    info "Falling back to building yazi from source..."
    if ensure_build_tools && ensure_cargo && cargo install --force yazi-build; then
        unmark_manual yazi; return 0
    fi

    warn "Could not install yazi automatically."
}

# GoReleaser-style OS/arch tokens for sesh's release assets, which are named
# sesh_<OS>_<arch>.tar.gz (e.g. sesh_Linux_x86_64.tar.gz, sesh_Darwin_arm64.tar.gz).
# NOTE: this differs from target_triple() (Rust) — sesh keeps x86_64 but uses
# arm64 (not aarch64) and capitalised OS names.
goreleaser_os_arch() {
    local arch os
    case "$(uname -m)" in
        x86_64|amd64)  arch="x86_64" ;;
        arm64|aarch64) arch="arm64" ;;
        i386|i686)     arch="i386" ;;
        *) return 1 ;;
    esac
    case "$(uname -s)" in
        Darwin) os="Darwin" ;;
        Linux)  os="Linux" ;;
        *) return 1 ;;
    esac
    echo "${os}_${arch}"
}

# Install sesh from the official GitHub prebuilt binary (no Go toolchain needed).
# Assets: sesh_<OS>_<arch>.tar.gz containing a top-level `sesh` binary.
install_sesh_from_github() {
    local osarch url tmp
    osarch="$(goreleaser_os_arch)" || return 1
    url="https://github.com/joshmedeski/sesh/releases/latest/download/sesh_${osarch}.tar.gz"
    tmp="$(mktemp -d)"
    info "Downloading sesh prebuilt binary ($osarch)..."
    if curl -fsSL "$url" -o "$tmp/sesh.tar.gz" && tar xzf "$tmp/sesh.tar.gz" -C "$tmp"; then
        mkdir -p "$HOME/.local/bin"
        find "$tmp" -type f -name sesh -exec install -m755 {} "$HOME/.local/bin/" \;
        rm -rf "$tmp"
        command -v sesh >/dev/null 2>&1 || [[ -x "$HOME/.local/bin/sesh" ]]
    else
        rm -rf "$tmp"
        return 1
    fi
}

install_sesh() {
    if command -v sesh >/dev/null 2>&1; then
        info "sesh already installed."
        unmark_manual sesh; return 0
    fi

    # sesh is packaged on Homebrew core; elsewhere (apt/dnf/pacman) it is not,
    # so try brew directly, then fall back to the prebuilt GitHub binary, then
    # to `go install`. (Runtime deps tmux + zoxide are both in CORE_DEPS.)
    if [[ "$PM" == "brew" ]]; then
        if brew install sesh; then unmark_manual sesh; return 0; fi
    fi

    info "sesh not available via $PM — trying prebuilt binary..."
    if install_sesh_from_github; then
        unmark_manual sesh; return 0
    fi

    if command -v go >/dev/null 2>&1; then
        info "Falling back to 'go install' for sesh..."
        if go install github.com/joshmedeski/sesh/v2@latest; then
            unmark_manual sesh; return 0
        fi
    fi

    warn "Could not install sesh automatically."
    MANUAL_DEPS+=("sesh")
}

#--------------------------------------------------------------------
# Per-package extra dependencies (installed only when selected)
#--------------------------------------------------------------------
pkg_deps() {
    case "$1" in
        hypr)      echo "hyprland hypridle hyprlock hyprsunset" ;;
        waybar)    echo "waybar" ;;
        dunst)     echo "dunst" ;;
        tofi)      echo "tofi" ;;
        wal)       echo "pywal" ;;
        foot)      echo "foot" ;;
        MangoHud)  echo "mangohud" ;;
        rmpc)      echo "rmpc" ;;
        aerospace) echo "aerospace" ;;
        ghostty)   echo "ghostty" ;;
        *)         echo "" ;;
    esac
}

install_selected_deps() {
    local pkg deps
    local to_install=()
    for pkg in "${SELECTED[@]}"; do
        deps="$(pkg_deps "$pkg")"
        [[ -n "$deps" ]] && to_install+=($deps)
    done
    if [[ ${#to_install[@]} -gt 0 ]]; then
        step "Installing dependencies for selected packages"
        pkg_install "${to_install[@]}"
    fi

    # Tools with special install/fallback handling, only if selected.
    if selected_has starship; then step "Installing starship"; install_starship; fi
    if selected_has yazi;     then step "Installing yazi";     install_yazi;     fi
    if selected_has opencode; then step "Installing opencode"; install_opencode; fi
    if selected_has sesh;     then step "Installing sesh";     install_sesh;     fi

    # The `work` package pulls in sesh (it ships a sesh.toml) but isn't the sesh
    # package itself, so install the sesh binary for it too.
    if selected_has work && ! selected_has sesh; then
        step "Installing sesh (for work package)"; install_sesh
    fi
}

# True if a package is in the SELECTED list.
selected_has() {
    local p
    for p in "${SELECTED[@]}"; do [[ "$p" == "$1" ]] && return 0; done
    return 1
}

#--------------------------------------------------------------------
# Neovim: compare packaged version with GitHub stable
#--------------------------------------------------------------------
ver_normalize() { sed -E 's/^v//; s/[^0-9.].*$//'; }
ver_ge() {
    # ver_ge A B -> 0 if A >= B
    [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" = "$2" ]
}

pm_nvim_version() {
    case "$PM" in
        brew)   brew info --json=v2 neovim 2>/dev/null | grep -m1 '"stable"' | sed -E 's/.*"stable": *"([^"]+)".*/\1/' ;;
        apt)    apt-cache policy neovim 2>/dev/null | awk '/Candidate:/{print $2}' ;;
        pacman) pacman -Si neovim 2>/dev/null | awk -F': ' '/Version/{print $2; exit}' ;;
        dnf)    dnf info neovim 2>/dev/null | awk -F': ' '/Version/{print $2; exit}' ;;
    esac
}

# Neovim's own asset naming: nvim-{linux|macos}-{x86_64|arm64}.tar.gz
nvim_asset() {
    local arch os
    case "$(uname -m)" in
        x86_64|amd64)  arch="x86_64" ;;
        arm64|aarch64) arch="arm64" ;;
        *) return 1 ;;
    esac
    case "$(uname -s)" in
        Darwin) os="macos" ;;
        Linux)  os="linux" ;;
        *) return 1 ;;
    esac
    echo "nvim-${os}-${arch}"
}

# Install neovim from the official GitHub prebuilt tarball into
# ~/.local/<asset>/ and symlink bin/nvim into ~/.local/bin (on PATH).
install_neovim_from_github() {
    local asset url tmp dest
    asset="$(nvim_asset)" || return 1
    url="https://github.com/neovim/neovim/releases/latest/download/${asset}.tar.gz"
    tmp="$(mktemp -d)"
    info "Downloading neovim prebuilt binary ($asset)..."
    if curl -fsSL "$url" -o "$tmp/nvim.tar.gz" && tar -xzf "$tmp/nvim.tar.gz" -C "$tmp"; then
        dest="$HOME/.local/$asset"
        rm -rf "$dest"
        mkdir -p "$HOME/.local" "$HOME/.local/bin"
        mv "$tmp/$asset" "$dest"
        ln -sf "$dest/bin/nvim" "$HOME/.local/bin/nvim"
        rm -rf "$tmp"
        [[ -x "$HOME/.local/bin/nvim" ]]
    else
        rm -rf "$tmp"
        return 1
    fi
}

install_neovim() {
    step "Neovim"
    local gh_ver pm_ver
    # The 'stable' tag is a moving alias (tag_name == "stable"); use the
    # latest release, whose tag_name is the real version (e.g. v0.12.4).
    # The trailing '|| true' stops a failed pipe (e.g. no network, grep no
    # match) from aborting the script under 'set -e -o pipefail'.
    gh_ver="$(curl -s https://api.github.com/repos/neovim/neovim/releases/latest 2>/dev/null \
        | grep -m1 '"tag_name"' | sed -E 's/.*"tag_name": *"([^"]+)".*/\1/' | ver_normalize || true)"
    pm_ver="$(pm_nvim_version | ver_normalize || true)"

    if [[ -z "$gh_ver" ]]; then
        warn "Couldn't reach GitHub for the latest stable version; using the packaged neovim."
        pkg_install neovim; return
    fi
    if [[ -z "$pm_ver" ]]; then
        warn "Neovim not offered by $PM. Latest stable is v$gh_ver."
        if install_neovim_from_github; then
            info "Installed neovim v$gh_ver from GitHub."
        else
            info "Couldn't install the prebuilt binary automatically."
            info "  https://github.com/neovim/neovim/releases/tag/stable"
            MANUAL_DEPS+=("neovim (v$gh_ver)")
        fi
        return
    fi

    info "Packaged neovim: v$pm_ver  |  GitHub stable: v$gh_ver"
    if ver_ge "$pm_ver" "$gh_ver"; then
        info "Packaged version is up to date — installing via $PM."
        pkg_install neovim
    else
        warn "Packaged neovim (v$pm_ver) is older than stable (v$gh_ver)."
        if confirm "Install the older packaged version anyway?"; then
            pkg_install neovim
        else
            info "Installing the latest stable (v$gh_ver) prebuilt binary instead..."
            if install_neovim_from_github; then
                info "Installed neovim v$gh_ver from GitHub."
            else
                info "Couldn't install the prebuilt binary automatically."
                info "  https://github.com/neovim/neovim/releases/tag/stable"
                MANUAL_DEPS+=("neovim (v$gh_ver)")
            fi
        fi
    fi
}

#--------------------------------------------------------------------
# Package discovery & selection
#--------------------------------------------------------------------
ALL_PACKAGES=()
discover_packages() {
    local d base
    for d in "$REPO_DIR"/*/; do
        base="$(basename "$d")"
        local skip=0
        local np
        for np in "${NON_PACKAGES[@]}"; do [[ "$base" == "$np" ]] && skip=1; done
        [[ $skip -eq 0 ]] && ALL_PACKAGES+=("$base")
    done
}

# Predefined groups
GROUP_CORE=(zsh shell nvim starship tmux bin ssh xdg-dirs yazi sesh)
GROUP_DESKTOP_LINUX=(hypr waybar dunst tofi wal foot MangoHud)
GROUP_DESKTOP_MACOS=(aerospace ghostty)
# Work-laptop-only package (CoreWeave). Excluded from `all`; opt-in via this group.
GROUP_WORK=(work)

expand_group() {
    case "$1" in
        core)          printf '%s\n' "${GROUP_CORE[@]}" ;;
        desktop-linux) printf '%s\n' "${GROUP_DESKTOP_LINUX[@]}" ;;
        desktop-macos) printf '%s\n' "${GROUP_DESKTOP_MACOS[@]}" ;;
        work)          printf '%s\n' "${GROUP_WORK[@]}" ;;
        all)           printf '%s\n' "${ALL_PACKAGES[@]}" ;;
    esac
}

# Comma-separated contents of a group (for display).
group_contents() {
    expand_group "$1" | awk 'NR>1{printf ", "}{printf "%s",$0}END{print ""}'
}

# Print what each offered group contains.
print_group_legend() {
    info "Group contents:"
    printf "    %-16s %s\n" "all" "every package (excludes work)"
    printf "    %-16s %s\n" "core" "$(group_contents core)"
    [[ "$OS" == "linux" ]] && printf "    %-16s %s\n" "desktop-linux" "$(group_contents desktop-linux)"
    [[ "$OS" == "macos" ]] && printf "    %-16s %s\n" "desktop-macos" "$(group_contents desktop-macos)"
    printf "    %-16s %s\n" "work" "$(group_contents work)  (CoreWeave work laptop)"
    return 0
}

# Choose a multi-select tool: fzf if available, else the bash `select`
# fallback. Sets the global SELECTOR.
SELECTOR=""
pick_selector() {
    if command -v fzf >/dev/null 2>&1; then SELECTOR="fzf"; return; fi
    SELECTOR="select"
}

SELECTED=()
select_packages() {
    step "Choose what to install"
    print_group_legend

    # Build the menu: groups first (with their contents shown), then packages.
    # Group entries are labelled "group:<name>  (pkg, pkg, ...)"; the leading
    # "group:<name>" token is parsed back out when expanding.
    local menu=()
    menu+=("group:all  (everything, excludes work)")
    menu+=("group:core  ($(group_contents core))")
    [[ "$OS" == "linux" ]] && menu+=("group:desktop-linux  ($(group_contents desktop-linux))")
    [[ "$OS" == "macos" ]] && menu+=("group:desktop-macos  ($(group_contents desktop-macos))")
    menu+=("group:work  ($(group_contents work))")
    local p
    for p in "${ALL_PACKAGES[@]}"; do menu+=("$p"); done

    local suggested="core"
    [[ "$OS" == "macos" ]] && suggested="core + desktop-macos"
    [[ "$OS" == "linux" ]] && suggested="core + desktop-linux"
    info "Suggested for $OS: $suggested (you can pick anything below)"

    local chosen=() line
    pick_selector

    # NOTE: use a `while read` loop rather than `mapfile`/`readarray`, which
    # don't exist in bash 3.2 (the default on macOS).
    info "You can select one or more entries (mix groups and individual packages)."
    case "$SELECTOR" in
        fzf)
            info "Use TAB or SPACE to mark multiple (a '>' marker appears), ENTER to confirm."
            while IFS= read -r line; do [[ -n "$line" ]] && chosen+=("$line"); done \
                < <(printf '%s\n' "${menu[@]}" | \
                    fzf --multi --marker='> ' --prompt="select (TAB=mark)> " \
                        --bind 'space:toggle+down' \
                        --header="TAB or SPACE = mark, ENTER = confirm your marked items" || true) ;;
        select)
            echo "Enter numbers separated by spaces to pick several (e.g. '2 12 15'):"
            local i=1
            for item in "${menu[@]}"; do printf "  %2d) %s\n" "$i" "$item"; i=$((i+1)); done
            local nums reply
            read -r reply
            for nums in $reply; do
                [[ "$nums" =~ ^[0-9]+$ ]] && chosen+=("${menu[$((nums-1))]}")
            done ;;
    esac

    [[ ${#chosen[@]} -eq 0 ]] && { error "Nothing selected. Aborting."; exit 1; }

    # Expand groups and de-duplicate. A group label looks like
    # "group:core  (zsh, shell, ...)"; take the first whitespace-delimited
    # field ("group:core") and strip the "group:" prefix.
    local raw=() c token
    for c in "${chosen[@]}"; do
        if [[ "$c" == group:* ]]; then
            token="${c%% *}"          # -> group:core
            while read -r g; do raw+=("$g"); done < <(expand_group "${token#group:}")
        else
            raw+=("$c")
        fi
    done
    # de-dup
    local seen=" " item
    for item in "${raw[@]}"; do
        [[ "$seen" == *" $item "* ]] && continue
        SELECTED+=("$item"); seen+="$item "
    done

    # The `work` package ships a full ~/.config/sesh/sesh.toml (base + CoreWeave
    # nodes). It would collide with the base `sesh` package's sesh.toml, so when
    # both are selected, drop base `sesh` and let `work` own that file.
    if [[ "$seen" == *" work "* && "$seen" == *" sesh "* ]]; then
        warn "'work' provides sesh.toml (base + CoreWeave nodes); dropping base 'sesh' to avoid a stow conflict."
        local filtered=() s
        for s in "${SELECTED[@]}"; do [[ "$s" == "sesh" ]] || filtered+=("$s"); done
        SELECTED=("${filtered[@]}")
    fi

    info "Will stow: ${SELECTED[*]}"
}

#--------------------------------------------------------------------
# Stow
#--------------------------------------------------------------------
# Back up any existing non-symlink targets that would block stowing $pkg,
# so a fresh machine with default dotfiles (e.g. ~/.zshenv) doesn't conflict.
# Backups go to <file>.pre-stow.bak.
backup_conflicts() {
    local pkg="$1" rel target
    # List files the package provides (relative to the package dir).
    while IFS= read -r rel; do
        target="$HOME/$rel"
        # Only back up real files/dirs that aren't already our symlink.
        if [[ -e "$target" && ! -L "$target" ]]; then
            info "Backing up existing $target -> $target.pre-stow.bak"
            mv "$target" "$target.pre-stow.bak"
        fi
    done < <(cd "$REPO_DIR/$pkg" && find . -type f -o -type l | sed 's|^\./||')
}

stow_packages() {
    step "Stowing packages"

    # The `work` package provides ~/.config/sesh/sesh.toml (base + CoreWeave
    # nodes), which collides with the base `sesh` package. If we're about to
    # stow `work`, make sure base `sesh` isn't stowed first — otherwise stow
    # aborts on the symlink conflict (backup_conflicts skips symlinks). This
    # also covers the case where `sesh` was stowed on an earlier install run.
    if printf '%s\n' "${SELECTED[@]}" | grep -qx "work"; then
        if [[ -L "$HOME/.config/sesh/sesh.toml" ]]; then
            info "Unstowing base 'sesh' so 'work' can own ~/.config/sesh/sesh.toml"
            ( cd "$REPO_DIR" && stow -D sesh ) 2>/dev/null || true
        fi
    fi

    local pkg
    for pkg in "${SELECTED[@]}"; do
        if [[ ! -d "$REPO_DIR/$pkg" ]]; then
            warn "Package '$pkg' not found in $REPO_DIR — skipping."
            continue
        fi
        info "stow -R $pkg"
        if ! ( cd "$REPO_DIR" && stow -R "$pkg" ) 2>/dev/null; then
            # Likely a conflict with pre-existing files — back them up and retry.
            warn "Conflicts detected for '$pkg'; backing up existing files and retrying."
            backup_conflicts "$pkg"
            if ! ( cd "$REPO_DIR" && stow -R "$pkg" ); then
                warn "Failed to stow '$pkg' — resolve manually."
            fi
        fi
    done
}

#--------------------------------------------------------------------
# Shell change (guarded)
#--------------------------------------------------------------------
set_default_shell() {
    step "Default shell"
    local zsh_path
    zsh_path="$(command -v zsh || true)"
    [[ -z "$zsh_path" ]] && { warn "zsh not found on PATH; skipping shell change."; return; }

    if [[ "${SHELL:-}" == "$zsh_path" ]]; then
        info "zsh is already your login shell."
        return
    fi
    if ! confirm "Set zsh ($zsh_path) as your default shell?"; then
        info "Leaving login shell unchanged."
        return
    fi
    # Ensure the zsh path is a valid login shell (needed for Homebrew zsh).
    if ! grep -qx "$zsh_path" /etc/shells 2>/dev/null; then
        info "Adding $zsh_path to /etc/shells"
        echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
    fi
    if chsh -s "$zsh_path"; then
        info "Login shell set to zsh (restart your terminal)."
    else
        warn "chsh failed; set your shell manually: chsh -s $zsh_path"
    fi
}

#--------------------------------------------------------------------
# Main
#--------------------------------------------------------------------
main() {
    print_banner
    printf "\n${GREEN}Dotfiles installer${NC}\n"
    printf "Repo: %s\n" "$REPO_DIR"
    printf "You'll pick which configs to install, then this will install their\n"
    printf "dependencies, stow them, and optionally set zsh as your shell.\n\n"

    detect_platform
    confirm "Continue?" || { info "Aborted."; exit 0; }

    ensure_homebrew
    discover_packages

    # Choose everything first (nothing is installed before this), then do
    # all installs together.
    select_packages

    install_core_deps
    install_selected_deps
    install_neovim
    stow_packages

    # Post-stow: needs ~/.config/opencode to already be a stow symlink.
    if selected_has opencode; then setup_engram_opencode; fi

    set_default_shell

    step "Done"
    info "Stowed: ${SELECTED[*]}"
    # Filter out any empty entries before reporting.
    local real_manual=() d
    for d in "${MANUAL_DEPS[@]:-}"; do [[ -n "$d" ]] && real_manual+=("$d"); done
    if [[ ${#real_manual[@]} -gt 0 ]]; then
        warn "These need manual installation: ${real_manual[*]}"
    fi
    info "Open a new terminal to pick up your new shell/config."
}

main "$@"
