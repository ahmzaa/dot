{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  // Defaults to 1, which silently makes "delegate to `explore` via task"
  // a no-op inside any subagent — node-triage hands 260KB AWX logs to
  // explore, so it needs 2.
  //
  // SECURITY: raising this is only safe because every read-only subagent
  // pins `permission.task`. Without that, a subagent with `edit: deny`
  // could spawn the built-in `general` agent (full write) and edit through
  // it. If you add a read-only subagent, give it a task deny/allowlist.
  "subagent_depth": 2,
  "model": "anthropic/claude-sonnet-5",
  // Prompt-cache traffic dominates cost: measured over 56 sessions, cache
  // writes were 58% of spend and cache reads 37%, vs 5.6% for output and
  // ~0% for fresh input. So context size is the cost driver, not reasoning
  // effort. prune drops stale tool outputs instead of carrying them for the
  // life of the session and re-caching them on every cache expiry.
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2
  },
  "agent": {
    // "high" not "xhigh" for latency, not cost — output is only ~5.6% of
    // spend, so the reasoning knob is nearly cost-neutral. Cycle up with the
    // variant_cycle keybind on turns that need it.
    "build": {
      "model": "anthropic/claude-opus-5",
      "variant": "high"
    },
    // Low volume, high leverage — this is the place to spend reasoning.
    // opus-5 not fable-5: fable is tuned for creative writing and costs 2x
    // ($10/$50 vs $5/$25 per Mtok), opus-5 is the coding/agent model.
    "plan": {
      "model": "anthropic/claude-opus-5",
      "variant": "xhigh"
    },
    // Re-enables the obsidian_* tools that the top-level "tools" key turns
    // off everywhere else. The rest of this agent (prompt, mode, model,
    // permissions) lives in agents/obsidian.md — but `tools` MUST be here,
    // not in that file's frontmatter: `tools` is not an allowed frontmatter
    // field, so opencode would silently route it into `options` and the
    // gating would do nothing.
    "obsidian": {
      "tools": {
        "obsidian_*": true
      }
    }
  },
  "mcp": {
    "engram": {
      "enabled": true,
      "type": "local",
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ]
    },
    "gitea-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "gitea-mcp",
        "-t", "stdio",
        "-H", "https://tea.ahmza.com",
        "-T", "{env:GITEA_TOKEN}"
      ]
    },
    // Operates on the vault's markdown directly — Obsidian does not need to
    // be running, and no Local REST API plugin is involved.
    //
    // The vault is NOT a git repo and nextcloud-sync writes to it every 15m,
    // so this server's journal/trash is the only undo that exists. Recovery
    // data lives in <vault>/.obsidian-mcp, which is excluded from Nextcloud
    // sync via the plugin's excludedFolders. Capped well under the 1 GiB /
    // 30-day default so an un-exclusion can't quietly balloon the sync.
    //
    // Vault id is "my-mind-2-0", not "my-mind-2.0": ids allow only
    // [a-z0-9_-] and must start with a letter, so the dot is rejected.
    "obsidian": {
      "enabled": true,
      "type": "local",
      "command": [
        "obsidian-mcp", "serve",
        "--vault", "my-mind-2-0=/Users/hahmed/Documents/my-mind-2.0",
        "--recovery-days", "14",
        "--recovery-max-bytes", "268435456"
      ]
    }
  },
  // Keeps all 13 obsidian_* tool definitions out of context for every agent
  // that doesn't need them, which is nearly all of them. Only agents.obsidian
  // turns them back on. Same cache-write logic as the compaction block above:
  // an idle MCP server is pure recurring cost.
  //
  // This uses the deprecated `tools` key rather than `permission` on purpose.
  // `permission: "deny"` blocks a tool's *execution* but still advertises its
  // definition to the model, so it would save nothing. `tools: false` is what
  // opencode's own MCP docs use for exactly this, and it omits the definition.
  // If `tools` is ever removed, the replacement must be verified to drop the
  // definition — not merely to deny the call.
  "tools": {
    "obsidian_*": false
  },
  "plugin": [
    "@honcho-ai/opencode-honcho"
  ]
}
