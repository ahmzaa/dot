{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "engram": {
      "enabled": true,
      "type": "local",
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ]
    },
    "gitea-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "gitea-mcp",
        "-t", "stdio",
        "-H", "https://tea.ahmza.com",
        "-T", "{env:GITEA_TOKEN}"
      ]
    }
  }
}
