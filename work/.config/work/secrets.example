# ─────────────────────────────────────────────────────────────────────────────
# Work secrets / internal endpoints — EXAMPLE template.
#
# Copy this to `secrets` (same dir) on the work laptop and fill in real values.
# The real `secrets` file is gitignored so internal CoreWeave URLs never hit git.
#
# Sourced by work/.config/zsh/hosts/CW-DYQN400C5P-L on the work host, before
# opencode reads its config, so {env:CW_*_URL} substitutions resolve.
# ─────────────────────────────────────────────────────────────────────────────

# opencode MCP endpoints (internal — require CoreWeave VPN/auth)
export CW_GLEAN_URL="https://<glean-host>/mcp/default"
export CW_ATLASSIAN_URL="https://mcp.atlassian.com/v1/mcp"
export CW_SOURCEGRAPH_URL="https://<sourcegraph-host>/.api/mcp"
export CW_MISSION_CONTROL_URL="https://<mission-control-host>/mcp"
export CW_DOCS_URL="https://<docs-host>/mcp"
export CW_WANDB_DOCS_URL="https://docs.wandb.ai/mcp"
export CW_GITHUB_MCP_URL="https://api.githubcopilot.com/mcp"

# GITHUB_TOKEN is expected to already be exported elsewhere (e.g. shell/vars).
